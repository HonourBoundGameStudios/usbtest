<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    Use this file to define which USB devices should trigger your app.
    You can specify devices by vendor ID and/or product ID.

    For example, to target FTDI devices:
    <usb-device vendor-id="1027" product-id="24577" />

    For CDC/ACM devices:
    <usb-device vendor-id="9025" />
    -->

    <!-- Example: Accept all devices with the USB CDC class -->
    <usb-device class="2" /> <!-- Communication Device Class -->

    <!-- Example: Specific USB-to-Serial adapters by vendor ID -->
    <!-- FTDI -->
    <usb-device vendor-id="1027" />
    <!-- Silabs CP210x -->
    <usb-device vendor-id="4292" />
    <!-- Prolific -->
    <usb-device vendor-id="1659" />

    <!-- You can add specific devices as needed -->
</resources>